# API
NODE_ENV=development
API_PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Database — sqlite for local; oracle for production
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=1521
DB_USER=rol_user
DB_PASSWORD=rol_password
DB_SERVICE=ORCL
# Optional full Easy Connect: host:port/service
# DB_CONNECT_STRING=hostname:1521/ORCL
DB_SCHEMA=NLECO
# Local DB uses sql.js (no native build / Visual Studio required)
SQLITE_PATH=./data/rol.sqlite
SEED_ON_START=false
DB_LOGGING=false

# Oracle Instant Client 19 (Thick mode for node-oracledb)
ORACLE_CLIENT_LIB_DIR=C:\Oracle\instantclient_19_29

# Local CSV source (default resolves to monorepo Re-Order Reports)
REPORTS_PATH=D:\MY FILES\LECO HO IT\Project\Re Order Report\Re-Order Reports

# Analytics sidecar
ANALYTICS_URL=http://localhost:8000

# Web
VITE_API_URL=http://localhost:3000
